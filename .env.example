# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# NEVER commit your real .env file or Supabase Service Role Key to GitHub!
# ==============================================================================

# Client-side Supabase configuration (Used in the React application)
# Find these in your Supabase project dashboard under Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Researcher-only configuration (Used solely for local CSV data export scripts)
# DO NOT prefix with VITE_ to ensure it is NEVER bundled into frontend assets!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
